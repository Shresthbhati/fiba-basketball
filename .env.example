# Copy to .env for local dev. Never commit real secrets.
DATABASE_URL=postgres://courtiq:courtiq@localhost:5432/courtiq
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
PORT=3001
# Origin(s) of the web app that may call the API from a browser (comma separated). Required when the web app proxies /api.
ALLOWED_ORIGINS=http://localhost:3000
# Development/test only: write outgoing emails as JSON files into this directory instead of printing them (used by the Playwright recovery test).
# MAIL_OUTBOX_DIR=/tmp/courtiq-outbox
# Public base URL of the web app, used to build links in emails.
# WEB_BASE_URL=http://localhost:3000
